# Copy this file to .env on the VPS. Keep .env private: it holds keys and
# passwords and is ignored by Git.

# Docker database credentials. Replace the example password with a long,
# unique value before the first deployment.
POSTGRES_DB=trend_intelligence
POSTGRES_USER=trendjack
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password
DATABASE_URL=postgresql://trendjack:replace-with-a-long-unique-database-password@postgres:5432/trend_intelligence
REDIS_URL=redis://redis:6379/0

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=False
ALLOWED_HOSTS=trendjackhunter.tech,www.trendjackhunter.tech
CORS_ALLOWED_ORIGINS=https://trendjackhunter.tech,https://www.trendjackhunter.tech
CSRF_TRUSTED_ORIGINS=https://trendjackhunter.tech,https://www.trendjackhunter.tech
FRONTEND_URL=https://trendjackhunter.tech

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_SCORING_MODEL=gemini-3.1-flash-lite
GEMINI_CONTENT_MODEL=gemini-3.1-flash-lite
AI_AUTO_ANALYZE_NEW_TRENDS=False
AI_GENERATION_DAILY_LIMIT=30

# Keep the existing Resend values during migration. After the domain is
# verified in Resend, change the sender to an address at trendjackhunter.tech.
RESEND_API_KEY=
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
DEFAULT_FROM_EMAIL=TrendJack Hunter <onboarding@resend.dev>
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15

# One Google Web application client ID. It is public and is used by both the
# browser button and Django's server-side ID-token verification.
GOOGLE_OAUTH_CLIENT_ID=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
TIKTOK_RESEARCH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
