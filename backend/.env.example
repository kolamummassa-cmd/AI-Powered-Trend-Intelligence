# Copy to .env and fill in real values. Never commit the real .env file.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://postgres:postgres@localhost:5432/trend_intelligence
REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Per-account daily allowance for successful AI generation, refinement, and re-analysis.
# Set to 0 only for an intentionally unlimited plan.
AI_GENERATION_DAILY_LIMIT=30
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# AI providers — set the one(s) you have keys for. AI_PROVIDER picks the default.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini is suitable for a small demo. Keep auto-analysis off so calls only
# happen when a user selects Analyze now or Generate content brief.
GEMINI_API_KEY=
AI_AUTO_ANALYZE_NEW_TRENDS=False
# Optional overrides; Gemini 3.1 Flash-Lite is the default for both.
GEMINI_SCORING_MODEL=gemini-3.1-flash-lite
GEMINI_CONTENT_MODEL=gemini-3.1-flash-lite

# Google OAuth (Phase 1) — client ID must match the one the frontend uses
# to obtain the ID token; the backend only ever sees/verifies that token.
GOOGLE_OAUTH_CLIENT_ID=

# Where verification/reset links in emails point to.
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=noreply@trendintelligence.app

# Transactional verification/reset emails. For the Render demo, Resend's
# onboarding@resend.dev sender can deliver to the email that owns your Resend
# account. Once you own a domain, replace DEFAULT_FROM_EMAIL with it.
RESEND_API_KEY=
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
DEFAULT_FROM_EMAIL=Kuzana <onboarding@resend.dev>
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15

# Trend sources (Phase 9) — all optional; a platform using one of these
# adapters just won't poll successfully until its key/token is set.
# See apps/trend_sources/adapters.py docstrings for what access each
# one actually requires (some need application/approval, not just signup).
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
TIKTOK_RESEARCH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Production only
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
