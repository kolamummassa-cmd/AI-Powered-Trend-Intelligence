# Templated at container start (docker/start.sh runs envsubst on this file)
# because Render assigns $PORT at runtime and nginx config files can't read
# environment variables directly.
worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;

    upstream django_backend {
        server 127.0.0.1:8000;
    }

    upstream next_frontend {
        server 127.0.0.1:3000;
    }

    server {
        listen ${PORT};

        # Django: API, admin, and whitenoise-served static/media files.
        #
        # X-Forwarded-Proto is passed through as-is from Render's own edge
        # (which terminates TLS in front of this whole container), not set
        # to nginx's own $scheme — nginx only ever sees plain HTTP here, so
        # using $scheme would report "http" even for an HTTPS request and
        # send Django's SECURE_SSL_REDIRECT into a redirect loop.
        location /api/ {
            proxy_pass http://django_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        }

        location /admin/ {
            proxy_pass http://django_backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        }

        location /static/ {
            proxy_pass http://django_backend;
        }

        location /media/ {
            proxy_pass http://django_backend;
        }

        # Everything else: the Next.js frontend.
        location / {
            proxy_pass http://next_frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        }
    }
}
